{
  "name": "@hmtuslkn/opencode-mdc-rules",
  "version": "1.0.3",
  "description": "Cursor-style project rules and live sidebar status for OpenCode V1 and V2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamituslukun/opencode-mdc-rules.git"
  },
  "homepage": "https://github.com/hamituslukun/opencode-mdc-rules#readme",
  "bugs": {
    "url": "https://github.com/hamituslukun/opencode-mdc-rules/issues"
  },
  "keywords": ["opencode", "plugin", "mdc", "rules", "cursor"],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": ["src", "server.ts", "tui.ts", "README.md", "CHANGELOG.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": { "opencode": ">=1.18.29 <3" },
  "scripts": {
    "build:tsx": "bun scripts/build-tsx.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload",
    "test:smoke": "bun scripts/smoke.ts",
    "test:install-smoke": "bun scripts/install-smoke.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check && npm run build:tsx"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24",
    "chokidar": "^4.0.3",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5 <0.6",
    "@opentui/solid": ">=0.4.5 <0.6",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "1.18.29",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.0",
    "@types/picomatch": "^4.0.2",
    "babel-preset-solid": "^1.9.12",
    "typescript": "^5.9.3"
  }
}
